# Copy this file to .env and fill in real values. .env is gitignored.

# Where the Shangrilla FSD/TSD documents live on your machine.
# Must NOT be inside this repo. Example: /Users/yourname/shangrilla-data
SHANGRILLA_DATA_ROOT=/Users/yourname/shangrilla-data

# Postgres (must match docker-compose.yml)
POSTGRES_USER=shangrilla
POSTGRES_PASSWORD=changeme
POSTGRES_DB=shangrilla_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# External APIs
# Embeddings - Gemini, pinned model, see architecture doc for why
GEMINI_API_KEY=
# Generation - OpenRouter, model configurable
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
